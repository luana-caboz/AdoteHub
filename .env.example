# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# URL pública do site (sem barra no final). Em dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contato para ONGs que querem entrar (home). Opcionais: sem nenhum, o botão some.
# WhatsApp com DDI e DDD, só números (ex.: 5541999999999)
NEXT_PUBLIC_CONTATO_WHATSAPP=
NEXT_PUBLIC_CONTATO_EMAIL=
